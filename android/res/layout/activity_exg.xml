<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:text="exg-c"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/port"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/btn"
            android:text="no Knight"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/btn"
            android:text="USB"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/connect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/ok"
            android:text="Connect"
            android:textColor="@color/ink" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#12141A"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="starting…"
        android:textColor="@color/ok"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/ballStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="disconnected"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <Button
            android:id="@+id/ballLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/btn"
            android:text="Ball"
            android:textColor="@color/ink" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pairBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#3A1820"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/pairWho"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:text="wants EXG"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <Button
            android:id="@+id/pairYes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#2E8A58"
            android:text="Allow"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/pairNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#8A3038"
            android:text="No"
            android:textColor="@color/ink" />
    </LinearLayout>

    <TextView
        android:id="@+id/imuLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#12141A"
        android:fontFamily="monospace"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="6dp"
        android:text="IMU —"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tabMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:backgroundTint="#24322C"
                android:text="Main"
                android:textColor="@color/ink" />

            <Button
                android:id="@+id/tabCube"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:backgroundTint="@color/btn"
                android:text="Cube"
                android:textColor="@color/ink" />

            <Button
                android:id="@+id/tabAlgos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:backgroundTint="@color/btn"
                android:text="Algos"
                android:textColor="@color/ink" />

            <Button
                android:id="@+id/tabPoses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:backgroundTint="@color/btn"
                android:text="Takes"
                android:textColor="@color/ink" />

            <Button
                android:id="@+id/tabSet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="88dp"
                android:backgroundTint="@color/btn"
                android:text="Settings"
                android:textColor="@color/ink" />

            <Button
                android:id="@+id/tabHelp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="72dp"
                android:backgroundTint="@color/btn"
                android:text="Help"
                android:textColor="@color/ink" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/mainPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.abysscore.exgc.TraceView
                android:id="@+id/traces"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.abysscore.exgc.FftView
                android:id="@+id/fft"
                android:layout_width="match_parent"
                android:layout_height="40dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cubePane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/panel"
                android:padding="4dp">

                <Button
                    android:id="@+id/cubeAdd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="add cube" />

                <Button
                    android:id="@+id/cubeDel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="del" />

                <Button
                    android:id="@+id/cubeColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="color" />

                <Button
                    android:id="@+id/cubeZoomOut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="−" />

                <Button
                    android:id="@+id/cubeZoomIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+" />

                <Button
                    android:id="@+id/cubeFront"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="front" />

                <Button
                    android:id="@+id/cubeFloat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="float on" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/panel"
                android:gravity="center_vertical"
                android:paddingLeft="6dp"
                android:paddingRight="6dp">

                <TextView
                    android:id="@+id/cubeZoomLab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="88dp"
                    android:paddingEnd="8dp"
                    android:text="zoom 1.0×"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/cubeZoomBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="21"
                    android:maxHeight="4dp"
                    android:minHeight="32dp"
                    android:progressTint="@color/crimson"
                    android:thumbTint="@color/ink" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cubeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/panel"
                android:orientation="horizontal"
                android:padding="2dp" />

            <LinearLayout
                android:id="@+id/cubeBits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/panel"
                android:orientation="vertical"
                android:padding="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button android:id="@+id/cubeQ1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1 —" />
                    <Button android:id="@+id/cubeQ2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="2 —" />
                    <Button android:id="@+id/cubeQ3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="3 —" />
                    <Button android:id="@+id/cubeQ4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="4 —" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button android:id="@+id/cubeQ5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="5 —" />
                    <Button android:id="@+id/cubeQ6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="6 —" />
                    <Button android:id="@+id/cubeQ7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="7 —" />
                    <Button android:id="@+id/cubeQ8" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="8 —" />
                </LinearLayout>

                <TextView
                    android:id="@+id/cubeRule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="tap the cube name for its algo. tap a channel to override (default = cube)."
                    android:textColor="@color/muted" />
            </LinearLayout>

            <com.abysscore.exgc.CubeView
                android:id="@+id/cube"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/algosPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/panel"
                android:padding="8dp"
                android:text="CubalC. Help is the syntax. Apply checks it — broken source is not saved."
                android:textColor="@color/muted" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/panel">

                <LinearLayout
                    android:id="@+id/algoList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="2dp" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/panel"
                android:padding="2dp">

                <Button
                    android:id="@+id/algoAdd"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="add" />

                <Button
                    android:id="@+id/algoDel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="del" />

                <Button
                    android:id="@+id/algoReset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="reset" />

                <Button
                    android:id="@+id/algoRename"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="name" />

                <Button
                    android:id="@+id/algoHelpBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="help" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/algoHelpBox"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/panel"
                android:visibility="gone">

                <TextView
                    android:id="@+id/algoHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="10dp"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />
            </ScrollView>

            <EditText
                android:id="@+id/algoSrc"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@color/bg"
                android:fontFamily="monospace"
                android:gravity="top|start"
                android:hint="if ch1 &lt; ch5 then 1&#10;else 0"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="8"
                android:padding="8dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/algoApply"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="save CubalC" />

                <Button
                    android:id="@+id/algoUseCube"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="use on cube" />
            </LinearLayout>

            <TextView
                android:id="@+id/algoErr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textColor="@color/crimson"
                android:visibility="gone" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/poses"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Takes only. 1-second blink/clench Record stays on Main."
                    android:textColor="@color/muted" />

                <TextView
                    android:id="@+id/poseHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Tap a take to compare the live plot against it."
                    android:textColor="@color/ink" />

                <LinearLayout
                    android:id="@+id/poseList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profiles — tap to switch. Long-press to rename or delete. Electrode map stays. Plates and takes recook."
                    android:textColor="@color/muted" />

                <TextView
                    android:id="@+id/profNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="4dp"
                    android:text="now: (none)"
                    android:textColor="@color/ink" />

                <LinearLayout
                    android:id="@+id/profChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp" />

                <Button
                    android:id="@+id/profNew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save current as…" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/profExport"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Share file" />

                    <Button
                        android:id="@+id/profImport"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Open file" />
                </LinearLayout>

                <TextView
                    android:id="@+id/profList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:textColor="@color/muted"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="View — drag a bar. The plot corner is that µV and that much time."
                    android:textColor="@color/muted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingTop="4dp">

                    <TextView
                        android:id="@+id/scale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="88dp"
                        android:paddingEnd="8dp"
                        android:text="±200 µV"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/scaleBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:maxHeight="4dp"
                        android:minHeight="32dp"
                        android:progressTint="@color/ok"
                        android:thumbTint="@color/ink" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/win"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="88dp"
                        android:paddingEnd="8dp"
                        android:text="2 s"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/winBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="7"
                        android:maxHeight="4dp"
                        android:minHeight="32dp"
                        android:progressTint="@color/ok"
                        android:thumbTint="@color/ink" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/uiScale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="88dp"
                        android:paddingEnd="8dp"
                        android:text="UI 1.5×"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/uiBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="14"
                        android:maxHeight="4dp"
                        android:minHeight="32dp"
                        android:progressTint="@color/ok"
                        android:thumbTint="@color/ink" />
                </LinearLayout>

                <Button
                    android:id="@+id/board"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Auto" />

                <Button
                    android:id="@+id/streamMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="125 + IMU" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/flashOpen"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Flash" />

                    <Button
                        android:id="@+id/debugOpen"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Debug" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="Process — Band sets the filters. CAR subtracts the shared mean while each channel is one site (bias RLD). In NEG RAIL the sample is already a pair, so CAR stays off. Raw is the open-input check. Hold a button, or open Help."
                    android:textColor="@color/muted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/band"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="band raw" />

                    <Button
                        android:id="@+id/car"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CAR" />
                </LinearLayout>

                <TextView
                    android:id="@+id/carNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="4dp"
                    android:text="CAR stays off in NEG RAIL. Each sample is already + minus −, and that mean is left alone."
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/detrend"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="raw DC" />

                    <Button
                        android:id="@+id/env"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="wave" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/notch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="notch" />

                    <Button
                        android:id="@+id/hp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="hp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/lp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="lp off" />

                    <Button
                        android:id="@+id/algo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Algos tab" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="Board reaches this app two ways. USB: Knight on this device. LAN: type the share address. First connect asks Allow in the app and in a notification. Share EXG is how this device offers the board out."
                    android:textColor="@color/muted" />

                <TextView
                    android:id="@+id/apiLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="api off"
                    android:textColor="@color/ink" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/apiOn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="API on" />

                    <Button
                        android:id="@+id/apiBind"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="wifi" />

                    <Button
                        android:id="@+id/apiHz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="125 Hz" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/apiHttp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="settings 8765" />

                    <Button
                        android:id="@+id/apiUdp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="EXG 8766" />

                    <Button
                        android:id="@+id/apiTcp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="spare 8767" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/apiToken"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="lock off" />

                    <Button
                        android:id="@+id/apiPush"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="extra send off" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:text="Map &amp; settings — copy while EXG is connected. Unplug one device, plug the other, keep the same map."
                    android:textColor="@color/muted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/kitSend"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="send mine" />

                    <Button
                        android:id="@+id/kitTake"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="take theirs" />

                    <Button
                        android:id="@+id/kitBoth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="both ways" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:text="Who I follow — tap to use, long-press to forget"
                    android:textColor="@color/muted" />

                <LinearLayout
                    android:id="@+id/followList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:text="Who can follow — tap to revoke"
                    android:textColor="@color/muted" />

                <LinearLayout
                    android:id="@+id/allowList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="Locations — tap the name for the + site. With NEG RAIL the label is +− and the next button picks the − site. Hold a button for one line. Help lists every button."
                    android:textColor="@color/muted" />

                <Button
                    android:id="@+id/negRail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/btn"
                    android:text="bias RLD"
                    android:textColor="@color/ink" />

                <Button
                    android:id="@+id/restorePairs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="@color/btn"
                    android:text="Restore default pairs"
                    android:textColor="@color/ink" />

                <TextView
                    android:id="@+id/restoreHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:paddingTop="2dp"
                    android:paddingBottom="4dp"
                    android:text="FC3–CP3   FC1–CP1   FCz–CPz   FC2–CP2   FC4–CP4\nPO3–O1    POz–Oz    PO4–O2\nLeaves NEG RAIL where you set it."
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/chGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/helpPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="4dp"
                    android:text="Buttons"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="Hold any button for the same line in the status strip."
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/helpBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/learnBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/idLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingBottom="2dp"
            android:text="ID — NOISE (desk) → CALM (still) → blink or clench"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/calibrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calibrate" />

                <Button
                    android:id="@+id/clean"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DC off" />

                <Button
                    android:id="@+id/learnName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:text="name (tap)"
                    android:textColor="@color/ink" />

                <Button
                    android:id="@+id/record"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Record" />

                <Button
                    android:id="@+id/match"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MATCH" />

                <Button
                    android:id="@+id/csv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CSV" />

                <Button
                    android:id="@+id/pause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pause" />

                <Button
                    android:id="@+id/atom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Take" />

                <TextView
                    android:id="@+id/atomVs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text=""
                    android:textColor="@color/crimson"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp">

            <LinearLayout
                android:id="@+id/learnChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
