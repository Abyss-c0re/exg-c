<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:gravity="center_vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="12dp"
            android:text="exg-c"
            android:textColor="@color/ink"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/port"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/btn"
            android:text="no Knight"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/btn"
            android:text="this board"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/connect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/ok"
            android:text="Connect"
            android:textColor="@color/ink" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#12141A"
        android:ellipsize="end"
        android:maxLines="2"
        android:padding="8dp"
        android:text="starting…"
        android:textColor="@color/ok"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/imuLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#12141A"
        android:fontFamily="monospace"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="6dp"
        android:text="IMU —"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel">

        <Button
            android:id="@+id/tabMain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#24322C"
            android:text="Main"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/tabCube"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/btn"
            android:text="Cube"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/tabPoses"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/btn"
            android:text="Takes"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/tabSet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/btn"
            android:text="Settings"
            android:textColor="@color/ink" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/mainPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.abysscore.exgc.TraceView
                android:id="@+id/traces"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.abysscore.exgc.FftView
                android:id="@+id/fft"
                android:layout_width="match_parent"
                android:layout_height="56dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cubePane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/panel"
                android:padding="4dp">

                <Button
                    android:id="@+id/cubeViz"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="viz" />

                <Button
                    android:id="@+id/cubeMap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="map" />

                <Button
                    android:id="@+id/cubeZoomOut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="−" />

                <Button
                    android:id="@+id/cubeZoomIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+" />

                <Button
                    android:id="@+id/cubeFront"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="front" />

                <Button
                    android:id="@+id/cubeFloat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="float on" />

                <Button
                    android:id="@+id/cubeAlgo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="algo detect" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cubeChRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/panel"
                android:padding="2dp" />

            <LinearLayout
                android:id="@+id/cubeMapTools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/panel"
                android:gravity="center_vertical"
                android:padding="4dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/sitePrev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&lt;" />

                <TextView
                    android:id="@+id/siteLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Fp1"
                    android:textColor="@color/crimson"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/siteNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&gt;" />

                <Button
                    android:id="@+id/siteAssign"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assign" />
            </LinearLayout>

            <com.abysscore.exgc.CubeView
                android:id="@+id/cube"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/poses"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Takes only. 1-second blink/clench Record stays on Main."
                    android:textColor="@color/muted" />

                <TextView
                    android:id="@+id/poseHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Tap a take to compare the live plot against it."
                    android:textColor="@color/ink" />

                <LinearLayout
                    android:id="@+id/poseList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profiles — tap to switch. Long-press to rename or delete. Electrode map stays. Plates and takes recook."
                    android:textColor="@color/muted" />

                <TextView
                    android:id="@+id/profNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:paddingBottom="4dp"
                    android:text="now: (none)"
                    android:textColor="@color/ink" />

                <LinearLayout
                    android:id="@+id/profChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp" />

                <Button
                    android:id="@+id/profNew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save current as…" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/profExport"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Share file" />

                    <Button
                        android:id="@+id/profImport"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Open file" />
                </LinearLayout>

                <TextView
                    android:id="@+id/profList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:textColor="@color/muted"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="View — time window is how much of the plot you see"
                    android:textColor="@color/muted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/win"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="win 2s" />

                    <Button
                        android:id="@+id/scale"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="scale" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/uiScale"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="UI 1.5x" />

                    <Button
                        android:id="@+id/board"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="8-ch + IMU" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="Process — line-kill + CAR is the readable leftover. Raw is the open-input check. Bias (RLD) is per channel: tap bias ON / bias off."
                    android:textColor="@color/muted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/band"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="band raw" />

                    <Button
                        android:id="@+id/car"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CAR" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/detrend"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="raw DC" />

                    <Button
                        android:id="@+id/env"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="wave" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/notch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="notch" />

                    <Button
                        android:id="@+id/hp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="hp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/lp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="lp off" />

                    <Button
                        android:id="@+id/algo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="algo detect" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="Share leftover: turn share on. Follow leftover: pick a nearby name. Allow/No on the share side. Leftover rides Bluetooth. Wifi address is sent after Allow if wifi is up."
                    android:textColor="@color/muted" />

                <TextView
                    android:id="@+id/apiLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="api off"
                    android:textColor="@color/ink" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/apiOn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="API on" />

                    <Button
                        android:id="@+id/apiBind"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="wifi" />

                    <Button
                        android:id="@+id/apiHz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="125 Hz" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/apiHttp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="settings 8765" />

                    <Button
                        android:id="@+id/apiUdp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="leftover 8766" />

                    <Button
                        android:id="@+id/apiTcp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="spare 8767" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/apiToken"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="lock off" />

                    <Button
                        android:id="@+id/apiPush"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="extra send off" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:text="Who I follow — tap to use, long-press to forget"
                    android:textColor="@color/muted" />

                <LinearLayout
                    android:id="@+id/followList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:text="Who can follow — tap to revoke"
                    android:textColor="@color/muted" />

                <LinearLayout
                    android:id="@+id/allowList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:text="Channels — site name = color. ON = acquire. bias = RLD. gN = gain."
                    android:textColor="@color/muted" />

                <LinearLayout
                    android:id="@+id/chGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/learnBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/idLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:text="ID — NOISE (desk) → CALM (still) → blink or clench"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/calibrate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Calibrate" />

            <Button
                android:id="@+id/clean"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DC off" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/learnName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:text="name (tap)"
                android:textColor="@color/ink" />

            <Button
                android:id="@+id/record"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Record" />

            <Button
                android:id="@+id/match"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MATCH" />

            <Button
                android:id="@+id/csv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CSV" />

            <Button
                android:id="@+id/pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pause" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/atom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Take" />

            <TextView
                android:id="@+id/atomVs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:text=""
                android:textColor="@color/crimson"
                android:textSize="14sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp">

            <LinearLayout
                android:id="@+id/learnChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
